+        .suh = try exl3View(l, maps, fmt(&nb[1], "{s}.suh", .{prefix}), g.k * 2),
+        .svh = try exl3View(l, maps, fmt(&nb[2], "{s}.svh", .{prefix}), g.n * 2),
