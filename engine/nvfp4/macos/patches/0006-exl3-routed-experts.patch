 }
+
+// Synthetic mul1 3.0 trellis experts: an LCG bitstream is a valid circular stream, so every state decodes.
+const Trellis = struct {
+    matrix: projection.Matrix,
+    storage: [4]u64,
+    k: usize,
+    n: usize,
+
+    fn init(g: *Gpu, kd: usize, n: usize, seed: u64) !Trellis {
+        var t: Trellis = .{ .matrix = undefined, .storage = @splat(0), .k = kd, .n = n };
+        const words = (kd / 16) * (n / 16) * 48; // 6 halves of 8 int16 words per 16x16 tile
+        const trellis = try g.alloc(words * 2);
+        const suh = try g.alloc(kd * 2);
+        const svh = try g.alloc(n * 2);
+        t.storage = .{ trellis, suh, svh, 0 };
+        var state = seed;
+        for (std.mem.bytesAsSlice(u16, g.host(trellis, words * 2))) |*v| {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            v.* = @truncate(state);
+        }
+        for (std.mem.bytesAsSlice(u16, g.host(suh, kd * 2)), 0..) |*v, i| v.* = @bitCast(@as(f16, if (i % 3 == 0) -0.75 else 1.125));
+        for (std.mem.bytesAsSlice(u16, g.host(svh, n * 2)), 0..) |*v, i| v.* = @bitCast(@as(f16, if (i % 5 == 0) -0.25 else 0.875));
+        for (t.storage[0..3]) |a| try g.indirect.append(g.gpa, g.ref(a).buf);
+        t.matrix = .{
+            .trellis = exl3.view(g, trellis),
+            .suh = exl3.view(g, suh),
+            .svh = exl3.view(g, svh),
+            .k = kd,
+            .n = n,
+            .width = .{ .halves = 6 },
+            .codebook = .mul1,
+        };
+        try t.matrix.validate();
+        return t;
+    }
+
+    /// y[n] = rotated dot of the BF16 row against this matrix's unpacked trellis, then unrotate and scale.
+    fn project(t: *const Trellis, g: *Gpu, x: []align(1) const u16, arena: std.mem.Allocator, out: []f32) !void {
+        const suh = std.mem.bytesAsSlice(f16, @as([]align(1) u8, g.host(t.storage[1], t.k * 2)));
+        const rotated = try arena.alloc(f16, t.k);
+        const unpacked = try arena.alloc(f16, t.k * t.n);
+        const words = std.mem.bytesAsSlice(i16, @as([]align(1) u8, g.host(t.storage[0], (t.k / 16) * (t.n / 16) * 48 * 2)));
+        format.unpack(t.matrix.width, t.matrix.codebook, @alignCast(words), t.k / 16, t.n / 16, unpacked);
+        for (0..t.k / 128) |b| {
+            var block: [128]f32 = undefined;
+            for (&block, 0..) |*v, i| v.* = @as(f32, @bitCast(@as(u32, x[b * 128 + i]) << 16)) * @as(f32, suh[b * 128 + i]);
+            decode.hadamard(&block);
+            for (block, 0..) |v, i| rotated[b * 128 + i] = @floatCast(v);
+        }
+        for (out, 0..) |*v, col| {
+            var sum: f64 = 0;
+            for (0..t.k) |j| sum += @as(f64, rotated[j]) * @as(f64, unpacked[j * t.n + col]);
+            v.* = @floatCast(sum);
+        }
+        for (0..t.n / 128) |b| decode.hadamard(out[b * 128 ..][0..128]);
+        const svh = std.mem.bytesAsSlice(f16, @as([]align(1) u8, g.host(t.storage[2], t.n * 2)));
+        for (out[0..t.n], svh) |*v, s| v.* *= @floatCast(s);
+    }
+};
+
+/// The production exl3.run chain — gate/up BF16, SwiGLU, down FP32 — over eight held mul1 3.0 experts
+/// pruned from a 256-ID router, checked stage by stage against the scalar trellis decoder.
+fn exl3Check(g: *Gpu) !void {
+    try g.flush();
+    const first = g.bufs.items.len;
+    const indirect_first = g.indirect.items.len;
+    defer {
+        g.flush() catch {};
+        g.indirect.shrinkRetainingCapacity(indirect_first);
+        g.releaseFrom(first);
+    }
+    var arena = std.heap.ArenaAllocator.init(g.gpa);
+    defer arena.deinit();
+    const held = [_]u8{ 1, 7, 19, 32, 65, 127, 200, 255 };
+    var layer: LayerStub = .{ .expert_count = held.len };
+    const kd = [_]usize{ H, H, I };
+    const nd = [_]usize{ I, I, H };
+    var mats: [3][E]Trellis = undefined;
+    for (0..3) |j| {
+        layer.exl3_tables[j] = try g.alloc(held.len * @sizeOf(projection.ExpertDescriptor));
+        const table = std.mem.bytesAsSlice(projection.ExpertDescriptor, g.host(layer.exl3_tables[j], held.len * @sizeOf(projection.ExpertDescriptor)));
+        for (held, 0..) |id, slot| {
+            mats[j][slot] = try Trellis.init(g, kd[j], nd[j], @intCast(0x9e37 + j * 257 + id));
+            table[slot] = try projection.descriptor(mats[j][slot].matrix);
+        }
+    }
+
+    const x = try g.alloc(max_rows * H * 2);
+    for (bfRows(g, x, max_rows * H), 0..) |*b, j| b.* = q.bf16(@as(f32, @floatFromInt(@as(i32, @intCast((j * 13) % 29)) - 14)) / 512);
+    const logits = try g.alloc(max_rows * 256 * 2);
+    var slot_map: [256]i32 = @splat(-1);
+    for (held, 0..) |id, slot| slot_map[id] = @intCast(slot);
+    const slots = try put(g, std.mem.sliceAsBytes(&slot_map), false);
+    for (bfRows(g, logits, max_rows * 256), 0..) |*b, j| b.* = q.bf16(if (slot_map[j % 256] >= 0) -2 else 100);
+    const picks = try g.alloc(pairs * 4);
+    const rw = try g.alloc(pairs * 4);
+    const act = try g.alloc(pairs * I * 2);
+    const down = try g.alloc(pairs * H * 4);
+    const gu = try g.alloc(pairs * 2 * I * 2); // gate | up halves, checked before down reuses the staging layout
+    const scratch = try g.alloc(try exl3.scratchBytes(pairs));
+    const pipes = try g.exl3Pipes();
+
+    var gate_score: Score = .{};
+    var up_score: Score = .{};
+    var act_score: Score = .{};
+    var down_score: Score = .{};
+    for ([_]usize{ 1, max_rows }) |rows| {
+        k.routerCompact(g, logits, 256, 0, picks, rw, slots, rows);
+        const count = rows * E;
+        // Gate/up land in `gu` untouched by the down overwrite; the same route drives a direct indexed encode.
+        const route: projection.Rows = .{
+            .count = count,
+            .x_stride = H,
+            .y_stride = I,
+            .routes = .{ .ids = exl3.view(g, picks), .repeat = E },
+        };
+        for ([_]u64{ layer.exl3_tables[0], layer.exl3_tables[1] }, 0..) |table, j| {
+            try projection.encodeIndexed(pipes, g.encoder(), .{
+                .descriptors = exl3.view(g, table),
+                .count = layer.expert_count,
+                .k = H,
+                .n = I,
+            }, exl3.view(g, x), .{ .buffer = exl3.view(g, gu).buffer, .offset = exl3.view(g, gu).offset + j * count * I * 2 }, exl3.view(g, scratch), route);
+        }
+        // The production chain then fills act and down itself.
+        try exl3.run(g, layer, rows, x, picks, act, down, scratch);
+        try g.flush();
+        const pick_ids = std.mem.bytesAsSlice(u32, @as([]align(1) u8, g.host(picks, count * 4)));
+        for (0..count) |pair| {
+            const slot = pick_ids[pair];
+            if (slot != pair % E) return error.PrunedRoutingMismatch;
+            const xr = bfRows(g, x + (pair / E) * H * 2, H);
+            const gw = try arena.allocator().alloc(f32, I);
+            const uw = try arena.allocator().alloc(f32, I);
+            const dw = try arena.allocator().alloc(f32, H);
+            try mats[0][slot].project(g, xr, arena.allocator(), gw);
+            try mats[1][slot].project(g, xr, arena.allocator(), uw);
+            const gr = bfRows(g, gu + pair * I * 2, I);
+            const ur = bfRows(g, gu + (count + pair) * I * 2, I);
+            const ar = bfRows(g, act + pair * I * 2, I);
+            for (0..I) |col| {
+                try gate_score.add(ref.fromBf16(gr[col]), ref.fromBf16(q.bf16(gw[col])), 0.0005 + @abs(gw[col]) * 0.002, col);
+                try up_score.add(ref.fromBf16(ur[col]), ref.fromBf16(q.bf16(uw[col])), 0.0005 + @abs(uw[col]) * 0.002, col);
+                const gate = ref.fromBf16(gr[col]);
+                const silu = ref.fromBf16(q.bf16(@floatCast(gate / (1 + @exp(-gate)))));
+                const want = ref.fromBf16(q.bf16(@floatCast(silu * ref.fromBf16(ur[col]))));
+                try act_score.add(ref.fromBf16(ar[col]), want, 0.0005 + @abs(want) * 0.002, col);
+            }
+            try mats[2][slot].project(g, ar, arena.allocator(), dw);
+            const dr = std.mem.bytesAsSlice(f32, @as([]align(1) u8, g.host(down + pair * H * 4, H * 4)));
+            for (0..H) |col| try down_score.add(dr[col], dw[col], 0.001 + @abs(dw[col]) * 0.002, col);
+            _ = arena.reset(.retain_capacity);
+        }
+    }
+    gate_score.report("drama3 EXL3 mul1 3.0 gate BF16 pruned decode+prompt");
+    up_score.report("drama3 EXL3 mul1 3.0 up BF16 pruned decode+prompt");
+    act_score.report("drama3 EXL3 SwiGLU pair rows");
+    down_score.report("drama3 EXL3 down FP32 decode+prompt");
+}
+
+/// Just the layer fields exl3.run reads, so the gate needs no loader.
+const LayerStub = struct {
+    exl3_tables: [3]u64 = .{ 0, 0, 0 },
+    expert_count: usize,
+};
