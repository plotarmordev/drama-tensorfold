-pub const Format = enum { fp8, nvfp4, int3 };
+pub const Format = enum { fp8, nvfp4, int3, exl3 };
+
+/// The only EXL3 layout the Metal runtime decodes: the mul1 codebook at 3.0 bpw (6 halves), fp16 scales.
+pub const exl3_halves: u16 = 6;
+const exl3_marker_names = [_][]const u8{ "mcg", "mul1" };
+
+fn exl3Trellis(e: anytype) ?struct { k: usize, n: usize } {
+    if (e.dtype != .i16 or e.rank != 3 or e.dim(2) != exl3_halves * 8) return null;
+    if (e.dim(0) == 0 or e.dim(1) == 0 or e.dim(0) > std.math.maxInt(usize) / 16 or e.dim(1) > std.math.maxInt(usize) / 16) return null;
+    const k = e.dim(0) * 16;
+    const n = e.dim(1) * 16;
+    if (k % 128 != 0 or n % 128 != 0) return null;
+    return .{ .k = k, .n = n };
+}
+
+fn mul1Marker(t: Tensor) bool {
+    return t.dtype == .i32 and t.rank == 0 and t.numel() == 1 and t.bytes.len == 4 and
+        std.mem.readInt(u32, t.bytes[0..4], .little) == core.exl3_format.Mul1Mul;
+}
+
+/// One expert `{prefix}` group's admission over the shard header (`ctx.has`/`entry`/`tensor` on part names):
+/// only the mul1 3.0 fp16-scales layout the runtime decodes; a bad group fails the layer, never falls back.
+pub fn exl3Group(prefix: []const u8, ctx: anytype) !struct { k: usize, n: usize } {
+    var nb: [4][192]u8 = undefined;
+    const e = ctx.entry(fmt(&nb[0], "{s}.trellis", .{prefix})) orelse return error.MissingExl3Part;
+    const g = exl3Trellis(e) orelse return error.BadExl3Shape;
+    var marker: ?[]const u8 = null;
+    for (exl3_marker_names) |name| {
+        if (!ctx.has(fmt(&nb[1], "{s}.{s}", .{ prefix, name }))) continue;
+        if (marker != null) return error.MixedExl3Markers;
+        marker = name;
+    }
+    const name = marker orelse return error.MissingExl3Marker;
+    if (!std.mem.eql(u8, name, "mul1") or !mul1Marker(try ctx.tensor(fmt(&nb[1], "{s}.{s}", .{ prefix, name })))) return error.BadExl3Marker;
+    if (ctx.has(fmt(&nb[2], "{s}.su", .{prefix})) or ctx.has(fmt(&nb[2], "{s}.sv", .{prefix})))
+        return error.PackedExl3Scales;
+    if (ctx.has(fmt(&nb[2], "{s}.bias", .{prefix}))) return error.BadExl3Bias;
+    const suh = try ctx.tensor(fmt(&nb[2], "{s}.suh", .{prefix}));
+    const svh = try ctx.tensor(fmt(&nb[3], "{s}.svh", .{prefix}));
+    if (!suh.is(.f16, &.{g.k}) or !svh.is(.f16, &.{g.n})) return error.BadExl3Scales;
+    return .{ .k = g.k, .n = g.n };
+}
 
 /// A row's code bytes for k inputs: NVFP4 nibbles, or int3's three 16-bit planes (sign, hi, lo) a 16-input block.
+/// `.exl3` experts carry no packed rows — their bytes live behind the trellis descriptors and never reach `codeBytes`.
 pub fn codeBytes(f: Format, k: usize) usize {
-    return if (f == .int3) k / 16 * 6 else k / 2;
+    return switch (f) {
+        .int3 => k / 16 * 6,
+        .fp8, .nvfp4 => k / 2,
+        .exl3 => unreachable,
+    };
 }
 
