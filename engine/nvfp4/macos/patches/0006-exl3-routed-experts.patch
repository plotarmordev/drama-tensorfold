index 000000000..59d2b6e79
--- /dev/null
+++ b/zig/src/families/drama3/metal/exl3.zig
@@ -0,0 +1,49 @@
+//! EXL3 routed experts over core's indexed trellis projection: gate/up rows repeat the pick's token row,
+//! the down projection reads SwiGLU pair rows one to one. Plain indexed routing only — no grouped members.
+const cfg = @import("../config.zig");
+const gpu = @import("gpu.zig");
+const k = @import("kernels.zig");
+const ex = @import("core").exl3_projection;
+
+const Gpu = gpu.Gpu;
+const I = cfg.expert_width;
+const H = cfg.hidden;
+
+pub fn view(g: *const Gpu, addr: u64) ex.View {
+    const r = g.ref(addr);
+    return .{ .buffer = r.buf, .offset = r.off };
+}
+
+/// Scratch bytes one chain of dispatches needs for `rows` routed rows; the down projection dominates.
+pub fn scratchBytes(rows: usize) !usize {
+    return @max(try ex.scratchBytes(H, I, rows), try ex.scratchBytes(I, H, rows));
+}
+
+fn encode(g: *Gpu, pipes: *const ex.Pipelines, table: u64, expert_count: usize, x: ex.View, y: ex.View, scratch: u64, r: ex.Rows, kd: usize, n: usize) !void {
+    try ex.encodeIndexed(pipes, g.encoder(), .{ .descriptors = view(g, table), .count = expert_count, .k = kd, .n = n }, x, y, view(g, scratch), r);
+}
+
+/// The routed chain: BF16 gate and up staged in `down_buf`'s first `pairs` rows of 2*I (gate | up halves so
+/// d3_swiglu reads one strided tensor), SwiGLU into `act`, then the FP32 down projection over the pair rows.
+/// `picks` holds the router's u32 slot IDs, one per row, matching the layer's held-ascending descriptor order.
+pub fn run(g: *Gpu, L: anytype, t: usize, x: u64, picks: u64, act: u64, down_buf: u64, scratch: u64) !void {
+    const pipes = try g.exl3Pipes();
+    const pairs = t * cfg.top_k;
+    const staged = view(g, down_buf);
+    const route: ex.Rows = .{
+        .count = pairs,
+        .x_stride = H,
+        .y_stride = I,
+        .routes = .{ .ids = view(g, picks), .repeat = cfg.top_k },
+    };
+    try encode(g, pipes, L.exl3_tables[0], L.expert_count, view(g, x), staged, scratch, route, H, I);
+    try encode(g, pipes, L.exl3_tables[1], L.expert_count, view(g, x), .{ .buffer = staged.buffer, .offset = staged.offset + pairs * I * 2 }, scratch, route, H, I);
+    k.swiglu(g, down_buf, I, 0, pairs * I, I, act, pairs);
+    try encode(g, pipes, L.exl3_tables[2], L.expert_count, view(g, act), staged, scratch, .{
+        .count = pairs,
+        .x_stride = I,
+        .y_stride = H,
+        .output = .f32,
+        .routes = .{ .ids = view(g, picks), .repeat = 1 },
+    }, I, H);
+}
