+/// The canonical assembler group at prefix: trellis [128, 32, 48] (k 2048, n 512), fp16 scales and one marker.
+fn putGroup(h: *FakeHeader, a: std.mem.Allocator, p: []const u8, marker: []const u8, magic: *const [4]u8) !void {
+    var name: [192]u8 = undefined;
+    try h.put(a, partName(&name, p, "trellis"), .i16, &.{ 128, 32, 48 }, exl3_bytes[0 .. 128 * 32 * 48 * 2]);
+    try h.put(a, partName(&name, p, "suh"), .f16, &.{2048}, exl3_bytes[0..4096]);
+    try h.put(a, partName(&name, p, "svh"), .f16, &.{512}, exl3_bytes[0..1024]);
+    if (marker.len != 0) try h.put(a, partName(&name, p, marker), .i32, &.{}, magic);
+}
