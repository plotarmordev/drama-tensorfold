+fn exl3View(l: *Loader, maps: []const u64, name: []const u8, bytes: usize) !projection.View {
+    const loc = try l.sh.locate(name);
+    if (loc.offset % 2 != 0) return error.MisalignedExpert;
+    const addr = maps[loc.file] + loc.offset;
+    l.w.mapped += bytes;
+    return .{ .buffer = l.g.ref(addr).buf, .offset = loc.offset };
