+// A shard header in memory: names to entries, and bytes for the tensors the admission reads.
+const FakeHeader = struct {
+    map: std.StringHashMapUnmanaged(struct { e: st.Entry, bytes: []const u8 }) = .empty,
+
+    fn deinit(h: *FakeHeader, a: std.mem.Allocator) void {
+        var it = h.map.keyIterator();
+        while (it.next()) |k| a.free(k.*);
+        h.map.deinit(a);
+    }
+    fn put(h: *FakeHeader, a: std.mem.Allocator, name: []const u8, dtype: st.DType, shape: []const usize, bytes: []const u8) !void {
+        var e: st.Entry = .{ .dtype = dtype, .rank = @intCast(shape.len), .shape = @splat(1), .begin = 0, .end = bytes.len };
+        @memcpy(e.shape[0..shape.len], shape);
+        const owned = try a.dupe(u8, name);
+        const gop = try h.map.getOrPut(a, owned);
+        if (gop.found_existing) {
+            a.free(owned); // a re-put keeps the first key's bytes
+        } else gop.key_ptr.* = owned;
+        gop.value_ptr.* = .{ .e = e, .bytes = bytes };
+    }
+    pub fn has(h: FakeHeader, name: []const u8) bool {
+        return h.map.contains(name);
+    }
+    pub fn entry(h: FakeHeader, name: []const u8) ?st.Entry {
+        const v = h.map.get(name) orelse return null;
+        return v.e;
+    }
+    pub fn tensor(h: FakeHeader, name: []const u8) !st.Tensor {
+        const v = h.map.get(name) orelse return error.MissingTensor;
+        return .{ .dtype = v.e.dtype, .rank = v.e.rank, .shape = v.e.shape, .bytes = v.bytes };
+    }
+};
+
+const exl3_bytes: [512 * 1024]u8 = @splat(0); // any part's backing bytes; admission reads only the marker's
+const mul1_magic: [4]u8 = .{ 0x2D, 0xD1, 0xDC, 0x83 }; // 0x83DCD12D little-endian, the mul1 codebook
+const mcg_magic: [4]u8 = .{ 0xED, 0x1F, 0xAC, 0xCB }; // 0xCBAC1FED, the mcg codebook the runtime refuses
+
+fn partName(buf: *[192]u8, prefix: []const u8, part: []const u8) []const u8 {
+    return std.fmt.bufPrint(buf, "{s}.{s}", .{ prefix, part }) catch unreachable;
+}
