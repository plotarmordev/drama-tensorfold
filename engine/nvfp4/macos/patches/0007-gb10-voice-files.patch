 ## Unreleased
 
+- Drama `--voices` folders also load the CUDA engine's `drama3-voice/1` and `drama3-voice/2` files as written, with their `codes_sha256` checked and their attestation kept; no re-encoding or reference audio. See [GB10 voice files](docs/drama-http-voices.md#gb10-voice-files).
+
 - Drama speech accepts dialogue tags `<|speaker:0|>` through `<|speaker:15|>` in whole and streamed HTTP requests and catalog reference transcripts. Untagged text still uses speaker 0, and catalogs still allow at most four reference passages. See [dialogue speakers](docs/drama-http-voices.md#dialogue-speakers).
 
 - Drama speech requests accept `temperature`, `top_p`, `top_k` (1 through 64) and exact unsigned 64-bit `seed` values. Whole replies, streams, catalog voices and redraws retain the requested settings; omitted or null fields keep the existing defaults. Explicit seeds advance by the attempt number for redraws. See [speech sampling](docs/speech-sampling.md).
diff --git a/docs/drama-http-voices.md b/docs/drama-http-voices.md
index 17013be6..630f0377 100644
--- a/docs/drama-http-voices.md
+++ b/docs/drama-http-voices.md
@@ -24,6 +24,10 @@ Reference `text` is the exact transcript. Codes are frame-major signed integers,
 
 The loader enforces the family's reference count, transcript length, frame count and codebook ranges before serving. It also rejects empty references, structural prompt tokens, malformed speaker tags, oversized files and oversized catalogs. The assembled prompt must still fit the engine's advertised prompt budget. Reference rows go through the same family `prompt.build` used by the generation CLI; only the tokenizer interface is adapted.
 
+### GB10 voice files
+
+The same folder also takes, unconverted, the files the CUDA engine's `--voices` loads: `drama3-voice/1` (one reference: `text`, `codes_sha256`, `frames`, `audio_sha256`, `encoder`, `source`, `vq_codes`) and `drama3-voice/2` (`source` and a `references` list of such entries). Their `vq_codes` are a codebook-major `[10, frames]` grid and must match `codes_sha256` (the SHA-256 of the grid as little-endian int32, codebook-major). Their `source.kind` is `model-invented`, `owner` or `consented`, with a nonempty `note`. Reference audio is never read. The same reference count, transcript, frame and code range limits apply.
+
 ## Dialogue speakers
 
 Speech input and reference transcripts accept `<|speaker:N|>` with decimal IDs from `0` through `15`. Tags can change speakers within one request. Untagged text defaults to speaker 0; a leading tag after Unicode whitespace is preserved. Leading zeros, negative IDs, non-ASCII digits, incomplete tags and IDs above 15 are rejected.
diff --git a/zig/src/server/drama_voice.zig b/zig/src/server/drama_voice.zig
index 41f24c96..6e3517e9 100644
--- a/zig/src/server/drama_voice.zig
+++ b/zig/src/server/drama_voice.zig
@@ -25,40 +25,86 @@ fn text(value: ?[]const u8, limit: usize) ![]const u8 {
     return s;
 }
 
+/// The ``source.kind`` values of this engine's catalogs, then of the GB10 host's drama3-voice files.
+const http_kinds = [_][]const u8{ "synthetic", "self", "consented" };
+const gb10_kinds = [_][]const u8{ "model-invented", "owner", "consented" };
+
+/// A drama3-http-voice/1 catalog, or a GB10 drama3-voice/1 (one reference) or /2 (several) file as written.
 pub fn parse(a: Allocator, bytes: []const u8) ![]const prompt.Reference {
     if (bytes.len > max_file_bytes) return error.BadVoice;
     const doc = switch (try json.parse(a, bytes)) {
         .ok => |v| v,
         else => return error.BadVoice,
     };
-    if (!std.mem.eql(u8, doc.strField("format") orelse "", "drama3-http-voice/1")) return error.BadVoice;
-    const source = doc.get("source") orelse return error.MissingAttestation;
-    const kind = source.strField("kind") orelse return error.MissingAttestation;
-    if (!std.mem.eql(u8, kind, "synthetic") and !std.mem.eql(u8, kind, "self") and !std.mem.eql(u8, kind, "consented")) return error.MissingAttestation;
-    _ = text(source.strField("note"), 4096) catch return error.MissingAttestation;
-    const values = (doc.get("references") orelse return error.BadVoice).items() orelse return error.BadVoice;
+    const format = doc.strField("format") orelse "";
+    const http = std.mem.eql(u8, format, "drama3-http-voice/1");
+    const several = std.mem.eql(u8, format, "drama3-voice/2");
+    if (!http and !several and !std.mem.eql(u8, format, "drama3-voice/1")) return error.BadVoice;
+    try attested(doc, if (http) &http_kinds else &gb10_kinds);
+    // a drama3-voice/1 file is its own one reference
+    const single = [_]json.Value{doc};
+    const values: []const json.Value = if (http or several) (doc.get("references") orelse return error.BadVoice).items() orelse return error.BadVoice else &single;
     if (values.len == 0 or values.len > 4) return error.BadVoice;
     const refs = try a.alloc(prompt.Reference, values.len);
     for (values, refs) |value, *ref| {
         const transcript = try text(value.strField("text"), 4096);
         if (try checks.problem(a, transcript) != null) return error.BadVoice;
-        const rows = (value.get("codes") orelse return error.BadVoice).items() orelse return error.BadVoice;
-        if (rows.len == 0 or rows.len > max_frames) return error.BadVoice;
-        const codes = try a.alloc([10]i32, rows.len);
-        for (rows, codes) |row, *code| {
-            const cells = row.items() orelse return error.BadVoice;
-            if (cells.len != 10) return error.BadVoice;
-            for (cells, 0..) |cell, i| {
-                const n = cell.int64() orelse return error.BadVoice;
-                if (n < 0 or n >= (if (i == 0) @as(i64, 4096) else 1024)) return error.BadVoice;
-                code[i] = @intCast(n);
-            }
-        }
-        ref.* = .{ .transcript = transcript, .codes = codes };
+        ref.* = .{ .transcript = transcript, .codes = try if (http) frameMajor(a, value) else codebookMajor(a, value) };
     }
     return refs;
 }
 
+fn attested(doc: json.Value, kinds: []const []const u8) !void {
+    const source = doc.get("source") orelse return error.MissingAttestation;
+    const kind = source.strField("kind") orelse return error.MissingAttestation;
+    for (kinds) |k| {
+        if (std.mem.eql(u8, kind, k)) break;
+    } else return error.MissingAttestation;
+    _ = text(source.strField("note"), 4096) catch return error.MissingAttestation;
+}
+
+/// drama3-http-voice/1 ``codes``: frame-major rows of ten.
+fn frameMajor(a: Allocator, value: json.Value) ![]const [10]i32 {
+    const rows = (value.get("codes") orelse return error.BadVoice).items() orelse return error.BadVoice;
+    if (rows.len == 0 or rows.len > max_frames) return error.BadVoice;
+    const codes = try a.alloc([10]i32, rows.len);
+    for (rows, codes) |row, *frame| {
+        const cells = row.items() orelse return error.BadVoice;
+        if (cells.len != 10) return error.BadVoice;
+        for (cells, frame, 0..) |cell, *c, book| c.* = try checkedCode(cell, book);
+    }
+    return codes;
+}
+
+/// drama3-voice ``vq_codes``: a [10, frames] codebook-major grid, which must match its ``codes_sha256``
+/// (little-endian int32, codebook-major) as the GB10 host requires.
+fn codebookMajor(a: Allocator, value: json.Value) ![]const [10]i32 {
+    const books = (value.get("vq_codes") orelse return error.BadVoice).items() orelse return error.BadVoice;
+    if (books.len != 10) return error.BadVoice;
+    const frames = (books[0].items() orelse return error.BadVoice).len;
+    if (frames == 0 or frames > max_frames) return error.BadVoice;
+    const codes = try a.alloc([10]i32, frames);
+    var digest = std.crypto.hash.sha2.Sha256.init(.{});
+    for (books, 0..) |row, book| {
+        const cells = row.items() orelse return error.BadVoice;
+        if (cells.len != frames) return error.BadVoice;
+        for (cells, codes) |cell, *frame| {
+            frame[book] = try checkedCode(cell, book);
+            digest.update(&std.mem.toBytes(std.mem.nativeToLittle(i32, frame[book])));
+        }
+    }
+    const hex = std.fmt.bytesToHex(digest.finalResult(), .lower);
+    if (!std.mem.eql(u8, value.strField("codes_sha256") orelse "", &hex)) return error.BadVoice;
+    return codes;
+}
+
+/// One code: semantic codes in [0, 4096), residual codes in [0, 1024).
+fn checkedCode(cell: json.Value, book: usize) !i32 {
+    const n = cell.int64() orelse return error.BadVoice;
+    if (n < 0 or n >= (if (book == 0) @as(i64, 4096) else 1024)) return error.BadVoice;
+    return @intCast(n);
+}
+
 pub fn load(a: Allocator, io: std.Io, path: []const u8) ![]const Voice {
     var dir = try std.Io.Dir.cwd().openDir(io, path, .{ .iterate = true });
     defer dir.close(io);
