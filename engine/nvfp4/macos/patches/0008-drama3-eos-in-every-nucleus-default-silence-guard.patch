+
+/// `--logits-out FILE`: every frame's candidate-head logits, fp32 `[frame, n_cand]`, appended as the frame is
+/// drawn — the raw record `results/smaller-builds/trace_eos.py` derives its per-frame tables from.
+const LogitsTrace = struct {
+    f: *anyopaque,
+    e: *d3.Engine,
+    buf: []f32,
+
+    fn open(ar: std.mem.Allocator, e: *d3.Engine, path: []const u8) !LogitsTrace {
+        const z = try ar.dupeSentinel(u8, path, 0);
+        const n = e.w.n_cand;
+        return .{ .f = fopen(z.ptr, "wb") orelse return error.LogitsOpen, .e = e, .buf = try ar.alloc(f32, n) };
+    }
+
+    fn probe(t: *LogitsTrace) d3.engine.Probe {
+        return .{ .ctx = t, .f = put };
+    }
+
+    fn put(ctx: *anyopaque, name: []const u8, ptr: u64, rows: usize, width: usize, is_f32: bool) anyerror!void {
+        _ = rows;
+        const t: *LogitsTrace = @ptrCast(@alignCast(ctx));
+        if (!is_f32 or !std.mem.eql(u8, name, "tower_decode0.candidate_logits")) return;
+        if (width != t.buf.len) return error.BadProbeRows;
+        try t.e.download(ptr, std.mem.sliceAsBytes(t.buf));
+        try writeAll(t.f, std.mem.sliceAsBytes(t.buf));
+    }
+
+    fn close(t: *LogitsTrace) void {
+        _ = fclose(t.f);
+    }
+};
