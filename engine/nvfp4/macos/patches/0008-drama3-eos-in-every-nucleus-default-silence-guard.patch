+/// Drama's default guard: a reply ends after 3.5 s below -40 dBFS. A silence-dominant distribution — one token
+/// near the whole nucleus mass with eos second — leaves the take trailing quiet around a late eos draw: the frame
+/// cap, or a long murmur tail below the floor. 3.5 s clears the longest quiet stretch inside any passing take
+/// (2.06 s built-in, 1.43 s reference), so a trip never cuts speech the take goes on to speak. Every field stays
+/// overridable; --silence-seconds 0 disables it.
+pub const default_silence: api.speech_guard.Config = .{ .floor_dbfs = -40, .seconds = 3.5 };
+
+/// Unset guard fields fall back to `default_silence`, so `--silence-floor-dbfs` alone keeps the default seconds.
+pub fn fillSilence(c: api.speech_guard.Config) api.speech_guard.Config {
+    return .{
+        .floor_dbfs = c.floor_dbfs orelse default_silence.floor_dbfs,
+        .seconds = c.seconds orelse default_silence.seconds,
+        .onset_seconds = c.onset_seconds,
+        .onset_voiced_seconds = c.onset_voiced_seconds,
+        .mid_seconds = c.mid_seconds,
+        .mid_min_voiced_s = c.mid_min_voiced_s,
+    };
+}
