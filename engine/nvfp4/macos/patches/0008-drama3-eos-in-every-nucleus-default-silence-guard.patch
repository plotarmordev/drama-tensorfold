+    // `draw_top` exempts the eos slot from truncation: eos second by logit, outside the request (top_p 0.9) and RAS
+    // (top_p 0.95) nuclei — cum(rank 0) = 0.953 — is still drawn sometimes, and always wins at rank 0. A shader
+    // that truncates eos like any other token never draws it in the first half (0 of 200) and the test fails; the
+    // draws are Philox-deterministic under the fixed seed and steps.
+    const lib = @import("drama3_metallib").bytes;
+    if (lib.len == 0) return error.SkipZigTest; // builds without Metal embed an empty library
+    const eos: i32 = 248046;
+    const sem_begin: i32 = 248099;
+    const cb: i32 = 4097;
+    const g = try @import("gpu.zig").Gpu.open(std.testing.allocator, lib);
+    defer g.close();
+    const logits = try g.alloc(4 * 3);
+    const ids_addr = try g.alloc(4 * 3);
+    const window = try g.alloc(4 * 16);
+    const step = try g.alloc(8);
+    const frame = try g.alloc(4 * 11);
+    const frames = try g.alloc(4 * 11 * 200);
+    const next = try g.alloc(4 * 11);
+    const pos = try g.alloc(4);
+    const count = try g.alloc(4);
+    try g.put(ids_addr, std.mem.sliceAsBytes(&[_]i32{ eos, sem_begin, sem_begin + 1 }));
+    const repeat_window: [16]i32 = @splat(sem_begin); // every draw of the dominant token repeats
+    try g.put(window, std.mem.sliceAsBytes(&repeat_window));
+    const sp: Sampling = .{ .temperature = 1.0, .top_k = 30, .top_p = 0.9, .seed = 0x6469_6e6f };
+    var all: [200 * 11]i32 = undefined;
+    for ([_][3]f32{ .{ 17.0, 20.0, 5.0 }, .{ 25.0, 20.0, 5.0 } }) |logits_for| {
+        try g.put(logits, std.mem.sliceAsBytes(&logits_for));
+        try g.put(step, std.mem.sliceAsBytes(&[_]u64{1}));
+        try g.put(count, std.mem.sliceAsBytes(&[_]i32{0}));
+        for (0..200) |_| {
+            sampleMain(g, logits, 3, ids_addr, window, sp, step, frame, sem_begin, cb, 0);
+            finishFrame(g, frame, frames, next, window, pos, step, count);
+        }
+        try g.get(frames, std.mem.sliceAsBytes(&all));
+        var drawn: usize = 0;
