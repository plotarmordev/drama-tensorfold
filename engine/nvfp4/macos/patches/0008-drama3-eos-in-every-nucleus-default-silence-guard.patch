+/// The candidate list slot holding eos (first below the band, last above it), or -1 when eos sits inside it:
+/// the sampler keeps that slot in every nucleus so a stop the model asks for cannot be truncated away.
+pub fn eosCandidate(c: cfg.Config, n_cand: usize) i32 {
+    if (c.ids.eos < c.ids.sem_begin) return 0;
+    if (c.ids.eos > c.ids.sem_end) return @intCast(n_cand - 1);
+    return -1;
+}
+
+test "eosCandidate mirrors candidateIds" {
+    const a = std.testing.allocator;
+    const none = [_]bool{false}**cfg.layers;
+    const idses = [_]cfg.Ids{
+        .{ .eos = 100, .pad = 0, .sem_begin = 200, .sem_end = 300, .audio_pad = 0 },
+        .{ .eos = 400, .pad = 0, .sem_begin = 200, .sem_end = 300, .audio_pad = 0 },
+    };
+    for (idses) |ids| {
+        const c = cfg.Config{ .ids = ids, .full_attention = none };
+        const got = eosCandidate(c, c.candidates());
+        const list = try candidateIds(a, c);
+        defer a.free(list);
+        try std.testing.expectEqual(c.ids.eos, list[@intCast(got)]);
+    }
+    const inside = cfg.Config{
+        .ids = .{ .eos = 250, .pad = 0, .sem_begin = 200, .sem_end = 300, .audio_pad = 0 },
+        .full_attention = none,
+    };
+    try std.testing.expectEqual(@as(i32, -1), eosCandidate(inside, inside.candidates()));
+}
