diff --git a/zig/kernels/metal/drama3/nvfp4.metal b/zig/kernels/metal/drama3/nvfp4.metal
index 451869bf6..11ca250c6 100644
--- a/zig/kernels/metal/drama3/nvfp4.metal
+++ b/zig/kernels/metal/drama3/nvfp4.metal
@@ -1,9 +1,11 @@
 // Packed row-major NVFP4: E2M1 nibbles, unsigned E4M3 block16 scales, FP32 projection globals.
+// Int3 (3.5 bits) shares scales and globals; each 16-input block is 6 bytes: u16 planes sign, hi, lo (bit i = input i),
+// coding 2 * (2 hi + lo) = the E2M1 values {0, 2, 4, 6}.
 #include "d3_common.h"
 
 struct Fp4Projection { device const uchar* w; device const uchar* s; device const float* global; };
 struct Fp4Expert { Fp4Projection g, u, d; };
-struct Fp4Args { uint K, N, prompt, cap, slots; };
+struct Fp4Args { uint K, N, prompt, cap, slots, int3; };
 
 inline float fp4_value(uchar code) {
   const float values[8] = {0.0f, 0.5f, 1.0f, 1.5f, 2.0f, 3.0f, 4.0f, 6.0f};
@@ -26,6 +28,23 @@ inline float fp4_row(Fp4Projection w, uint n, uint K, device const bf16* x, uint
   }
   return simd_sum(acc) * w.global[0];
 }
+inline float int3_row(Fp4Projection w, uint n, uint K, device const bf16* x, uint lane) {
+  float acc = 0.0f;
+  for (uint k = lane * 16; k < K; k += 512) {
+    device const uchar* p = w.w + (ulong)n * (K / 16 * 6) + k / 16 * 6;
+    const uint sign = p[0] | uint(p[1]) << 8, hi = p[2] | uint(p[3]) << 8, lo = p[4] | uint(p[5]) << 8;
+    float block = 0.0f;
+    for (uint j = 0; j < 16; ++j) {
+      const float v = float(2 * ((hi >> j) & 1) + ((lo >> j) & 1)) * 2.0f;
+      block = fma((sign >> j) & 1 ? -v : v, b2f(x[k + j]), block);
+    }
+    acc = fma(block, fp4_scale(w.s[(ulong)n * (K / 16) + k / 16]), acc);
+  }
+  return simd_sum(acc) * w.global[0];
+}
+inline float expert_row(Fp4Projection w, uint n, constant Fp4Args& a, device const bf16* x, uint lane) {
+  return a.int3 ? int3_row(w, n, a.K, x, lane) : fp4_row(w, n, a.K, x, lane);
+}
 
 [[max_total_threads_per_threadgroup(128)]] kernel void d3_nvfp4_up(
     device const bf16* x [[buffer(0)]], device const Fp4Expert* table [[buffer(1)]],
@@ -41,8 +60,8 @@ inline float fp4_row(Fp4Projection w, uint n, uint K, device const bf16* x, uint
   for (int j = 0; j < cnt; ++j) {
     const uint pair = a.prompt ? uint(members[(ulong)e * a.cap + j]) : tg.y;
     device const bf16* row = x + (ulong)(pair / a.slots) * a.K;
-    const float g = rb(fp4_row(w.g, n, a.K, row, lane));
-    const float u = rb(fp4_row(w.u, n, a.K, row, lane));
+    const float g = rb(expert_row(w.g, n, a, row, lane));
+    const float u = rb(expert_row(w.u, n, a, row, lane));
     if (lane == 0) out[(ulong)pair * a.N + n] = f2b(g / (1.0f + precise::exp(-g)) * u);
   }
 }
@@ -60,7 +79,7 @@ inline float fp4_row(Fp4Projection w, uint n, uint K, device const bf16* x, uint
   const Fp4Expert w = table[e];
   for (int j = 0; j < cnt; ++j) {
     const uint pair = a.prompt ? uint(members[(ulong)e * a.cap + j]) : tg.y;
-    const float v = fp4_row(w.d, n, a.K, x + (ulong)pair * a.K, lane);
+    const float v = expert_row(w.d, n, a, x + (ulong)pair * a.K, lane);
     if (lane == 0) out[(ulong)pair * a.N + n] = v;
   }
 }
