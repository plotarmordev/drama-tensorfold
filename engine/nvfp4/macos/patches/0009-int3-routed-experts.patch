+pub const Format = enum { fp8, nvfp4, int3 };
+
+/// A row's code bytes for k inputs: NVFP4 nibbles, or int3's three 16-bit planes (sign, hi, lo) a 16-input block.
+pub fn codeBytes(f: Format, k: usize) usize {
+    return if (f == .int3) k / 16 * 6 else k / 2;
+}
+
+/// NVFP4 and int3 share E4M3 block16 scales and an FP32 global; only the code row width differs.
+pub fn block16(f: Format, w: Tensor, s: Tensor, g: Tensor, n: usize, k: usize) !void {
+    const row = codeBytes(f, k);
+    if (k % 16 != 0 or !w.is(.u8, &.{ n, row }) or !s.is(.f8_e4m3, &.{ n, k / 16 }) or !g.is(.f32, &.{})) return error.BadNvfp4Shape;
+    if (w.bytes.len != n * row or s.bytes.len != n * k / 16 or g.bytes.len != 4) return error.BadNvfp4Shape;
     for (s.bytes) |b| if (b == 0x7f or b > 0x80) return error.BadNvfp4Scale;
     const global: f32 = @bitCast(std.mem.readInt(u32, g.bytes[0..4], .little));
     if (!(global > 0 and std.math.isFinite(global))) return error.BadScale;
