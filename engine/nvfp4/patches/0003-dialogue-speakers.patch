 /// prompt.py's ``validate_caller_text(text, location)`` for valid UTF-8 ``text``.
 pub fn callerText(a: Allocator, text: []const u8, location: []const u8) Allocator.Error!?[]const u8 {
     if (trimStart(text).len == 0) return try std.fmt.allocPrint(a, error_prefix ++ " {s}: text must not be empty", .{location});
@@ -134,6 +105,20 @@ pub fn tagged(a: Allocator, input: []const u8) Allocator.Error![]const u8 {
