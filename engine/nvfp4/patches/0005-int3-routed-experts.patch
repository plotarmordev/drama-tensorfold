+class Int3Tests(unittest.TestCase):
+    def test_hand_checked_bit_planes_and_round_trip(self):
+        values = [0, 2, 4, 6, 0, -2, -4, -6, 6, 4, 2, 0, -6, -4, -2, 0]
+        codes = torch.tensor([abs(v) // 2 | (8 if v < 0 else 0) for v in values], dtype=torch.uint8)
+        packed = q.pack_int3(codes.reshape(1, 1, 16))
+        self.assertEqual(tuple(packed.shape), (1, 1, 6))
+        self.assertEqual(packed.flatten().tolist(), [0xE0, 0x70, 0xCC, 0x33, 0xAA, 0x55])
+        sign, hi, lo = struct.unpack("<HHH", bytes(packed.flatten().tolist()))
+        decoded = [(-1 if sign >> i & 1 else 1) * 2 * (2 * (hi >> i & 1) + (lo >> i & 1))
+                   for i in range(16)]
+        self.assertEqual(decoded, values)
+        self.assertEqual(q.pack_int3(codes.repeat(2).reshape(1, 32)).tolist(),
+                         [packed.flatten().tolist() * 2])
+
+    def test_rounding_uses_only_int3_grid_and_even_ties(self):
+        values = torch.linspace(-8, 8, 257, dtype=torch.float64)
+        one = torch.ones_like(values)
+        indices = q.nearest(values.abs(), one, one, q.INT3)
+        rounded = q.INT3[indices.long()] * values.sign()
