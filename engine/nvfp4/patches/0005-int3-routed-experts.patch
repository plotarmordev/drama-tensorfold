+
+test "Int3 planes decode to the E2M1 values of their sign, hi and lo bits, negative zero included" {
+    const a = std.testing.allocator;
+    const n = 4;
+    const k = 32; // two blocks of 16 inputs a row, 12 bytes
+    var p: Int3 = try .alloc(a, n, k);
+    defer a.free(p.codes);
+    defer a.free(p.scales);
+    defer a.free(p.global);
+    @memset(p.scales, 0x38); // e4m3 1.0
+    @memset(p.global, 1);
+    @memset(p.codes, 0);
+    // expert 0 row 0 block 0: one input per (sign, hi, lo) combination; bytes are the three u16 planes
+    p.codes[0] = 0b1111_0000; // sign on inputs 4..7
+    p.codes[2] = 0b1100_1100; // hi on inputs 2, 3, 6, 7
+    p.codes[4] = 0b1010_1010; // lo on inputs 1, 3, 5, 7
+    var out: [n * k]f64 = undefined;
+    p.dequant(0, &out);
+    const want = [8]f64{ 0, 2, 4, 6, 0, -2, -4, -6 }; // input 4 is sign alone: negative zero
+    for (want, 0..) |w, c| try std.testing.expectEqual(w, out[c]);
+    try std.testing.expect(std.math.signbit(out[4])); // E2M1 0x8 keeps its sign, unlike a true zero
+    for (out[8..]) |v| try std.testing.expectEqual(@as(f64, 0), v);
+    // another expert, another row: input 31 sits at bit 15 of its block's u16 planes
+    const at = (1 * n + 2) * (3 * k / 8) + 6; // expert 1 row 2 block 1
+    p.codes[at + 1] = 0x80; // sign u16 high byte, bit 7 -> input 31 sign
+    p.codes[at + 5] = 0x80; // lo u16 high byte, bit 7 -> input 31 lo
+    p.dequant(1, &out);
+    try std.testing.expectEqual(@as(f64, -2), out[2 * k + 31]);
+    for (out[2 * k + 16 .. 2 * k + 31]) |v| try std.testing.expectEqual(@as(f64, 0), v);
+}
