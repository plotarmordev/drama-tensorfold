+            vals = torch.tensor([(-1 if sign >> i & 1 else 1) * 2 * (2 * (hi >> i & 1) + (lo >> i & 1))
+                                 for i in range(16)], dtype=torch.float64)
+            self.assertTrue(torch.equal(rec[0, row], (vals * q.SCALES[scales[0, row, 0].long()]) * g[0, row]))
+
