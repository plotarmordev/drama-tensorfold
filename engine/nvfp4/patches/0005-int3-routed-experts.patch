+def pack_int3(codes):
+    """Sign (bit 3) and magnitude index (bits 1:0) codes [..][k] into int3's per-16 little-endian u16 planes sign, hi, lo."""
+    blocks = codes.reshape(*codes.shape[:-1], -1, GROUP).long()
+    bits = 1 << torch.arange(GROUP, device=codes.device)
+    planes = torch.stack([(((blocks >> shift) & 1) * bits).sum(-1) for shift in (3, 1, 0)], -1)
+    return torch.stack((planes & 255, planes >> 8), -1).to(torch.uint8).flatten(-3)
