+        picks = torch.arange(16).reshape(2, 8)
+        settings = {"rows": [1] * 16 + [0] * 240, "kappa": 19, "damping": 0.025}
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder) / "provenance.json"
+            path.write_text(json.dumps({"kappa": 64, "layer_sources": [
+                {"layer": 3, "metadata": {"gptq": json.dumps(settings)}}]}))
+            layers, digest = q.provenance(path)
+            self.assertEqual(layers, {3: settings})
+            self.assertEqual(digest, hashlib.sha256(path.read_bytes()).hexdigest())
+            q.check_rows(picks, layers[3], 3)
+            with self.assertRaisesRegex(ValueError, "rows counts differ"):
+                q.check_rows(picks + 1, layers[3], 3)
+            hess = torch.eye(2)[None]
+            self.assertTrue(torch.equal(q.damp(hess, settings["damping"]), hess * 1.025))
+            self.assertTrue(torch.equal(q.shrink(hess, torch.tensor([1]), 2 * hess, settings["kappa"]),
+                                        hess * 39 / 20))
+
+    def test_int3_quantise_reconstruction(self):
+        w = torch.linspace(-6, 6, 32, dtype=torch.float64).reshape(1, 2, 16)
+        g = q.global_scale(w, "int3")[:, None].expand(-1, 2)
+        packed, scales, rec = q.quantise(w, torch.ones(1, 16, dtype=torch.float64), g, mode="int3")
