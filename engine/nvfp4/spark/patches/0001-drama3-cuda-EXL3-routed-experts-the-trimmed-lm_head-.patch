+test "a trimmed head's rows must name exactly the sampler's candidates" {
+    const none = try compactHead(null, &[_]i32{ 0, 5 });
+    try std.testing.expect(!none);
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const parsed = try std.json.parseFromSliceLeaky(std.json.Value, arena.allocator(), "{\"drama_head_rows\": [0, 5, 9]}", .{});
+    try std.testing.expect(try compactHead(parsed, &[_]i32{ 0, 5, 9 }));
+    try std.testing.expectError(error.HeadRowsMismatch, compactHead(parsed, &[_]i32{ 0, 5, 8 }));
+    try std.testing.expectError(error.HeadRowsMismatch, compactHead(parsed, &[_]i32{0}));
+}
