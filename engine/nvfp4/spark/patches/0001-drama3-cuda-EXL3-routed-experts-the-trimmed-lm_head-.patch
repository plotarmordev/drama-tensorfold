-/// The stored experts are exactly the map's: none unlisted, and every listed one's three projections present.
+/// True when the metadata's `drama_head_rows` is exactly `ids` (a trimmed lm_head in candidate order);
+/// absent is a full head, anything else is a cut the sampler's candidate list cannot name.
+pub fn compactHead(metadata: ?std.json.Value, ids: []const i32) !bool {
+    const meta = metadata orelse return false;
+    if (meta != .object) return error.BadExpertMap;
+    const rows = meta.object.get("drama_head_rows") orelse return false;
+    if (rows != .array or rows.array.items.len != ids.len) return error.HeadRowsMismatch;
+    for (rows.array.items, ids) |row, id| {
+        if (row != .integer or row.integer != id) return error.HeadRowsMismatch;
+    }
+    return true;
+}
