+    /// A layer's held EXL3 experts (mul1, 3.0 bits) in slot order: per-expert trellis pointers, widths and stacked
+    /// scales, exactly as the trellis stores them — the grouped kernels unpack on the device.
+    fn exl3Experts(l: *Loader, li: usize, held: *const quant.Held) !void {
+        const ids = held.ids[li][0..held.counts[li]];
+        const gpa = l.gpa;
+        var trellis: [3][]u64 = undefined;
+        var k2: [3][]i32 = undefined;
+        var suh: [3][]u8 = undefined;
+        var svh: [3][]u8 = undefined;
+        // gate and up: [I, H]; down: [H, I]
+        const shapes = [3][2]usize{ .{ cfg.expert_width, cfg.hidden }, .{ cfg.expert_width, cfg.hidden }, .{ cfg.hidden, cfg.expert_width } };
+        for ([_][]const u8{ "gate_proj", "up_proj", "down_proj" }, 0..) |proj, m| {
+            const n = shapes[m][0];
+            const k = shapes[m][1];
+            trellis[m] = try gpa.alloc(u64, ids.len);
+            k2[m] = try gpa.alloc(i32, ids.len);
+            suh[m] = try gpa.alloc(u8, ids.len * k * 2);
+            svh[m] = try gpa.alloc(u8, ids.len * n * 2);
+            for (ids, 0..) |e, slot| {
+                var nb: [2][192]u8 = undefined;
+                const base = fmt(&nb[0], "model.language_model.layers.{d}.mlp.experts.{d}.{s}", .{ li, e, proj });
+                const t = try l.sh.get(fmt(&nb[1], "{s}.trellis", .{base}));
+                if (!t.is(.i16, &.{ k / 16, n / 16, exl3_halves * 8 })) return error.BadExl3Expert;
+                const mk = try l.sh.get(fmt(&nb[1], "{s}.mul1", .{base}));
+                if (mk.numel() != 1 or mk.bytes.len != 4 or std.mem.readInt(u32, mk.bytes[0..4], .little) != mul1_magic) return error.BadExl3Expert;
+                const sh_in = try l.sh.get(fmt(&nb[1], "{s}.suh", .{base}));
+                const sv_in = try l.sh.get(fmt(&nb[1], "{s}.svh", .{base}));
+                if (!sh_in.is(.f16, &.{k}) or !sv_in.is(.f16, &.{n})) return error.BadExl3Expert;
+                const b = try l.alloc(t.bytes.len);
+                try l.stager.put(b.ptr, t.bytes);
+                trellis[m][slot] = b.ptr;
+                k2[m][slot] = exl3_halves;
+                @memcpy(suh[m][slot * k * 2 ..][0 .. k * 2], sh_in.bytes);
+                @memcpy(svh[m][slot * n * 2 ..][0 .. n * 2], sv_in.bytes);
+                for ([_][]const u8{ "trellis", "mul1", "suh", "svh" }) |s| l.sh.release(fmt(&nb[1], "{s}.{s}", .{ base, s }));
+            }
+        }
+        defer for (0..3) |m| {
+            gpa.free(trellis[m]);
+            gpa.free(k2[m]);
+            gpa.free(suh[m]);
+            gpa.free(svh[m]);
+        };
+        const lay: cuda.exl3_experts.Layer = .{
+            .gate = try l.upload(u64, trellis[0]),
+            .up = try l.upload(u64, trellis[1]),
+            .down = try l.upload(u64, trellis[2]),
+            .gate_k2 = try l.upload(i32, k2[0]),
+            .up_k2 = try l.upload(i32, k2[1]),
+            .down_k2 = try l.upload(i32, k2[2]),
+            .suh_g = try l.upload(u8, suh[0]),
+            .suh_u = try l.upload(u8, suh[1]),
+            .svh_g = try l.upload(u8, svh[0]),
+            .svh_u = try l.upload(u8, svh[1]),
+            .suh_d = try l.upload(u8, suh[2]),
+            .svh_d = try l.upload(u8, svh[2]),
+            .experts = ids.len,
+            .dims = cfg.hidden,
+            .width = cfg.expert_width,
+            .codebook = .mul1,
+            .uniform_k2 = exl3_halves,
+            .act_mode = 1, // fp32 silu(gate) * up, the reference SwiGLU
+        };
+        const L = &l.w.layers[li];
+        L.experts = .{ .format = .exl3, .exl3 = lay, .up = 0, .down = 0, .width = cfg.expert_width, .dims = cfg.hidden, .experts = ids.len, .swiglu = true };
+        L.slots = if (compactSlots(held, li)) |slots| try l.upload(i32, &slots) else 0;
+        if (L.slots != 0) l.w.compact_layers += 1;
+    }
 };
 
