+/// One JSON object per line of the --text file; `seed` replaces the command line's sampling seed.
+const CalibrationRequest = struct { text: []const u8, ref_text: ?[]const u8 = null, ref_codes: ?[]const u8 = null, seed: u64 = 1 };
+
+/// Generates every request, then prefills its prompt and generated frames again with the MoE inputs and routing dumped.
+fn calibrate(gpa: std.mem.Allocator, io: std.Io, a: Args, e: *d3.Engine, tok: *const core.tokenizer.Tokenizer, dir: []const u8) !u8 {
+    const path = a.text orelse return error.RequestsRequired;
+    const calibration = d3.calibration;
+    var dump = try calibration.Rows.create(gpa, io, dir, e.o.max_rows);
+    defer dump.deinit(gpa);
+    const lines = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 26));
+    defer gpa.free(lines);
+    var it = std.mem.tokenizeScalar(u8, lines, '\n');
+    while (it.next()) |line| {
+        var arena_state = std.heap.ArenaAllocator.init(gpa);
+        defer arena_state.deinit();
+        const ar = arena_state.allocator();
+        const q = try std.json.parseFromSliceLeaky(CalibrationRequest, ar, line, .{});
+        var refs: [1]d3.prompt.Reference = undefined;
+        if (q.ref_codes) |p| refs[0] = .{ .transcript = q.ref_text orelse return error.RefTextRequired, .codes = try readCodes(ar, io, p) };
+        const prompt = (try d3.prompt.build(ar, tok, q.text, refs[0..@intFromBool(q.ref_codes != null)])).frames;
+        var smp = a.smp;
+        smp.seed = q.seed;
+        const res = try e.generate(io, prompt, smp, a.max_frames, a.graphs, a.sync_every);
+        defer gpa.free(res.frames);
+        const rows = try std.mem.concat(ar, [W]i32, &.{ prompt, res.frames });
+        try dump.prefill(e, rows, try calibration.classify(ar, e.c.ids, rows, prompt.len));
+    }
+    try dump.finish(gpa, a.model, &try calibration.configDigest(gpa, io, a.model));
+    std.debug.print("RESULT drama3 calibration rows={d} layers={d} dir={s}\n", .{ dump.rows, d3.config.layers, dir });
+    return 0;
+}
+
 fn runRequest(gpa: std.mem.Allocator, io: std.Io, a: Args, e: *d3.Engine, tts: ?*d3.tts.Tts, tok: *const core.tokenizer.Tokenizer, q: Request) !void {
