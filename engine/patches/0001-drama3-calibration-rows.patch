     defer arena_state.deinit();
diff --git a/zig/src/families/drama3/metal/calibration_rows.zig b/zig/src/families/drama3/metal/calibration_rows.zig
new file mode 100644
index 000000000..dc3a255b0
--- /dev/null
+++ b/zig/src/families/drama3/metal/calibration_rows.zig
@@ -0,0 +1,126 @@
+//! GPTQ-compatible Drama 3 calibration rows captured from the Metal MoE input and router.
+const std = @import("std");
+const cfg = @import("../config.zig");
+const eng = @import("engine.zig");
+
+const W = cfg.frame_width;
+const kinds = [_][]const u8{ "x.bf16", "picks.i32", "w.f32" };
+const widths = [kinds.len]usize{ cfg.hidden * 2, cfg.top_k * 4, cfg.top_k * 4 };
+
+pub const Class = enum(u8) { prompt_text, prompt_audio, generated };
+
+/// The class of every row of a prompt followed by the frames generated after it.
+pub fn classify(gpa: std.mem.Allocator, ids: cfg.Ids, rows: []const [W]i32, prompt_rows: usize) ![]u8 {
+    const out = try gpa.alloc(u8, rows.len);
+    for (rows, out, 0..) |row, *c, i| {
+        const audio = row[0] >= ids.sem_begin and row[0] <= ids.sem_end;
+        c.* = @intFromEnum(if (i >= prompt_rows) Class.generated else if (audio) Class.prompt_audio else Class.prompt_text);
+    }
+    return out;
+}
+
+pub const Rows = struct {
+    io: std.Io,
+    dir: std.Io.Dir,
+    class: std.Io.File,
+    files: [cfg.layers][kinds.len]std.Io.File,
+    staging: []u8,
+    rows: usize = 0,
+    /// Classes of the sequence being prefilled and how many of its rows layer 0 has seen.
+    sequence: []const u8 = &.{},
+    seen: usize = 0,
+    sequences: std.ArrayList(Sequence) = .empty,
+
+    const Sequence = struct { offset: usize, rows: usize };
+
+    pub fn create(gpa: std.mem.Allocator, io: std.Io, path: []const u8, max_rows: usize) !Rows {
+        try std.Io.Dir.cwd().createDir(io, path, .default_dir);
+        const dir = try std.Io.Dir.cwd().openDir(io, path, .{});
+        errdefer dir.close(io);
+        const class = try dir.createFile(io, "class.u8", .{ .exclusive = true });
+        errdefer class.close(io);
+        const staging = try gpa.alloc(u8, max_rows * cfg.hidden * 2);
+        errdefer gpa.free(staging);
+        var r: Rows = .{ .io = io, .dir = dir, .class = class, .files = undefined, .staging = staging };
+        var created: usize = 0;
+        errdefer for (0..created) |i| r.files[i / kinds.len][i % kinds.len].close(io);
+        var name: [32]u8 = undefined;
+        for (&r.files, 0..) |*layer, l| for (layer, kinds) |*file, kind| {
+            file.* = try dir.createFile(io, try std.fmt.bufPrint(&name, "layer-{d:0>2}.{s}", .{ l, kind }), .{ .exclusive = true });
+            created += 1;
+        };
+        return r;
+    }
+
+    pub fn deinit(r: *Rows, gpa: std.mem.Allocator) void {
+        for (&r.files) |*layer| for (layer) |file| file.close(r.io);
+        r.class.close(r.io);
+        r.dir.close(r.io);
+        r.sequences.deinit(gpa);
+        gpa.free(r.staging);
+    }
+
+    /// Prefill `rows` through the engine with every layer's MoE input and routing appended to the dump.
+    pub fn prefill(r: *Rows, e: *eng.Engine, rows: []const [W]i32, classes: []const u8) !void {
+        try r.sequences.append(e.gpa, .{ .offset = r.rows, .rows = rows.len });
+        r.sequence = classes;
+        r.seen = 0;
+        var hook: Hook = .{ .rows = r, .engine = e };
+        e.route_probe = .{ .ctx = &hook, .f = Hook.callback };
+        defer e.route_probe = null;
+        try e.startPrompt(rows);
+        var at: usize = 0;
+        while (at < rows.len) : (at += e.o.max_rows) try e.promptChunk(rows.len, at, @min(e.o.max_rows, rows.len - at), null);
+        try e.flush();
+    }
+
+    fn capture(r: *Rows, e: *eng.Engine, layer: usize, x: u64, picks: u64, weights: u64, count: usize) !void {
+        const offset = r.rows;
+        if (layer == 0) {
+            try r.class.writePositionalAll(r.io, r.sequence[r.seen..][0..count], offset);
+            r.seen += count;
+        }
+        for (r.files[layer], [_]u64{ x, picks, weights }, widths) |file, source, width| {
+            const bytes = r.staging[0 .. count * width];
+            try e.download(source, bytes);
+            try file.writePositionalAll(r.io, bytes, offset * width);
+        }
+        if (layer == cfg.layers - 1) r.rows += count;
+    }
+
+    pub fn finish(r: *Rows, gpa: std.mem.Allocator, checkpoint: []const u8, config_sha256: []const u8) !void {
+        const manifest = try std.json.Stringify.valueAlloc(gpa, .{
+            .schema = "drama-probe-rows/1",
+            .identity = .{ .producer = "drama3-generate Metal", .checkpoint = checkpoint, .config_sha256 = config_sha256 },
+            .rows = r.rows,
+            .layers = cfg.layers,
+            .class = .{ .file = "class.u8", .dtype = "u8", .shape = .{r.rows}, .values = "0 prompt_text, 1 prompt_audio, 2 generated" },
+            .x = .{ .file = "layer-LL.x.bf16", .dtype = "bf16", .shape = .{ r.rows, cfg.hidden }, .source = "addRmsnorm output, the MoE input" },
+            .picks = .{ .file = "layer-LL.picks.i32", .dtype = "i32", .shape = .{ r.rows, cfg.top_k } },
+            .w = .{ .file = "layer-LL.w.f32", .dtype = "f32", .shape = .{ r.rows, cfg.top_k }, .source = "renormalized routing weights, slot order" },
+            .chunks = r.sequences.items,
+        }, .{ .whitespace = .indent_2 });
+        defer gpa.free(manifest);
+        try r.dir.writeFile(r.io, .{ .sub_path = "rows.json", .data = manifest, .flags = .{ .exclusive = true } });
+    }
+};
+
+const Hook = struct {
+    rows: *Rows,
+    engine: *eng.Engine,
+
+    fn callback(ctx: *anyopaque, layer: usize, x: u64, picks: u64, weights: u64, count: usize) anyerror!void {
+        const h: *Hook = @ptrCast(@alignCast(ctx));
+        try h.rows.capture(h.engine, layer, x, picks, weights, count);
+    }
+};
+
+pub fn configDigest(gpa: std.mem.Allocator, io: std.Io, checkpoint: []const u8) ![64]u8 {
+    const path = try std.fs.path.join(gpa, &.{ checkpoint, "config.json" });
+    defer gpa.free(path);
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+    defer gpa.free(bytes);
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &digest, .{});
+    return std.fmt.bytesToHex(digest, .lower);
+}
