const std = @import("std");
const shift = @import("drama_shift.zig");
const prompt = @import("drama_prompt.zig");

test "gpuchk carry" {
    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
    defer arena.deinit();
    const a = arena.allocator();
    const dialogue = @DIALOGUE@;
    const marked = try shift.read(a, dialogue, false);
    const parts = try shift.split(a, marked, 120);
    const second = std.mem.indexOf(u8, marked.text, "<|speaker:2|>").?;
    for (parts.segments, 0..) |part, i| {
        const start = @intFromPtr(part.ptr) - @intFromPtr(marked.text.ptr);
        const continued = try prompt.continued(a, part, marked.text[0..start]);
        const expected = if (start >= second) "<|speaker:2|>" else "<|speaker:1|>";
        const ok = std.mem.startsWith(u8, prompt.trimStart(continued), expected);
        std.debug.print("gpuchk-carry segment={d} start={d} len={d} expected={s} ok={}\n", .{ i + 1, start, part.len, expected, ok });
        try std.testing.expect(ok);
    }
}
