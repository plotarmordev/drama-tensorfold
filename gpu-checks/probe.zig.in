const std = @import("std");
const shift = @import("drama_shift.zig");
const spans = @import("drama_spans.zig");
const prompt = @import("drama_prompt.zig");

test "gpuchk exact long-form requests" {
    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
    defer arena.deinit();
    const a = arena.allocator();
    const markup = @MARKUP@;
    const dialogue = @DIALOGUE@;
    for ([_]bool{ false, true }) |honour| {
        const marked = try shift.read(a, markup, honour);
        const protected = try spans.collect(a, marked.text);
        const parts = try shift.split(a, marked, 120);
        try std.testing.expect(parts.segments.len > 1);
        for (parts.segments) |part| {
            const start = @intFromPtr(part.ptr) - @intFromPtr(marked.text.ptr);
            const end = start + part.len;
            for (protected) |span| {
                try std.testing.expect(!(start > span.start and start < span.end));
                try std.testing.expect(!(end > span.start and end < span.end));
            }
        }
    }
    const marked = try shift.read(a, dialogue, false);
    const parts = try shift.split(a, marked, 120);
    try std.testing.expect(parts.segments.len > 1);
    const second = std.mem.indexOf(u8, marked.text, "<|speaker:2|>").?;
    for (parts.segments) |part| {
        const start = @intFromPtr(part.ptr) - @intFromPtr(marked.text.ptr);
        const continued = try prompt.continued(a, part, marked.text[0..start]);
        const expected = if (start >= second) "<|speaker:2|>" else "<|speaker:1|>";
        try std.testing.expect(std.mem.startsWith(u8, prompt.trimStart(continued), expected));
    }
}
