-/// Encode [K,N] with its full [K,K] Hessian; `reconstructed` comes from the chosen states, not the packed trellis.
+/// Lower Cholesky factor of the [k,k] matrix `m`, in place; the upper triangle is left as it was.
+fn cholesky(m: []f64, k: usize) !void {
+    for (0..k) |j| {
+        const row_j = m[j * k ..][0..j];
+        var d = m[j * k + j];
+        for (row_j) |v| d -= v * v;
+        if (!(d > 0)) return error.NotPositiveDefinite;
+        const root = @sqrt(d);
+        m[j * k + j] = root;
+        for (j + 1..k) |i| {
+            var s = m[i * k + j];
+            for (m[i * k ..][0..j], row_j) |a, b| s -= a * b;
+            m[i * k + j] = s / root;
+        }
+    }
+}
+
+/// LDLQ feedback into rows [r0, r0+16) of `target` from the errors `e` of every later row, with `l` the lower Cholesky
+/// factor of H: the 16 rows' error is weighed by H only through their own block once the target absorbs
+/// L_jj^-T sum_{i>j} L_ij^T e_i, built in `sum` [16,n].
+fn feedback(l: []const f64, e: []const f64, target: []f64, sum: []f64, k: usize, n: usize, r0: usize) void {
+    @memset(sum, 0);
+    for (r0 + 16..k) |i| for (0..16) |c| {
+        const lic = l[i * k + r0 + c];
+        for (sum[c * n ..][0..n], e[i * n ..][0..n]) |*v, x| v.* += lic * x;
+    };
+    var c: usize = 16;
+    while (c > 0) {
+        c -= 1;
+        for (c + 1..16) |r| {
+            const lrc = l[(r0 + r) * k + r0 + c];
+            for (sum[c * n ..][0..n], sum[r * n ..][0..n]) |*v, x| v.* -= lrc * x;
+        }
+        const diag = l[(r0 + c) * k + r0 + c];
+        for (sum[c * n ..][0..n]) |*v| v.* /= diag;
+    }
+    for (target[r0 * n ..][0 .. 16 * n], sum) |*x, v| x.* += v;
+}
+
+/// Encode [K,N] with its full [K,K] Hessian by exllamav3's LDLQ: H rotated like W and damped by 2.5 % of its mean
+/// diagonal, 16-row blocks from last to first, each tile the least squared error to its fed-back target.
+/// `reconstructed` comes from the chosen states, not the packed trellis.
 pub fn encode(gpa: Allocator, weight: []const f64, hessian: []const f64, k: usize, n: usize, width: exl3.Width) !Result {
     if (k == 0 or n == 0 or k % 128 != 0 or n % 128 != 0 or weight.len != k * n or hessian.len != k * k or width.halves < 4 or width.halves > 8) return error.BadShape;
     var arena_state = std.heap.ArenaAllocator.init(gpa);
